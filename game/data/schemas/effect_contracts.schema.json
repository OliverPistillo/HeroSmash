{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profile": {
      "const": "base_text_v1"
    },
    "pilots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "legacyId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 150
          },
          "originalTextSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "proposal": {
            "type": "string",
            "minLength": 1
          },
          "jsNotes": {
            "type": "string",
            "minLength": 1
          },
          "parity": {
            "enum": [
              "exact",
              "equivalent",
              "legacy approximation",
              "unresolved",
              "requires special handler"
            ]
          },
          "lifecycle": {
            "enum": [
              "implemented",
              "unresolved"
            ]
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "trigger": {
                  "enum": [
                    "combat_start",
                    "basic_attack",
                    "basic_hit",
                    "skill_cast",
                    "skill_hit",
                    "damage_taken",
                    "hp_threshold",
                    "status_applied",
                    "dodge",
                    "heal",
                    "interval",
                    "death_prevention",
                    "combat_end",
                    "shop_enter",
                    "card_purchased",
                    "round_end"
                  ]
                },
                "chance_bp": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "interval_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3600000
                },
                "loss_threshold_milli": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "condition": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "always",
                        "critical",
                        "regen",
                        "status",
                        "reflectable"
                      ]
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "actions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "enum": [
                          "deal_damage",
                          "modify_stat",
                          "apply_status",
                          "heal",
                          "add_shield",
                          "gain_energy",
                          "modify_cooldown",
                          "extra_attack",
                          "repeat_skill",
                          "execute",
                          "resource_conversion",
                          "shop_modification",
                          "special_handler"
                        ]
                      },
                      "target": {
                        "enum": [
                          "self",
                          "opponent"
                        ]
                      },
                      "amount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000000
                      },
                      "unit": {
                        "enum": [
                          "milli",
                          "basis_points",
                          "stacks"
                        ]
                      },
                      "field": {
                        "type": "string"
                      },
                      "formula": {
                        "enum": [
                          "flat",
                          "missing_hp_percent"
                        ]
                      },
                      "factor_bp": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000
                      },
                      "minimum": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000000
                      },
                      "cap": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000000
                      },
                      "damage_kind": {
                        "enum": [
                          "none",
                          "magic",
                          "phys",
                          "health_loss"
                        ]
                      },
                      "handler": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "target",
                      "amount",
                      "unit",
                      "field",
                      "formula",
                      "factor_bp",
                      "minimum",
                      "cap",
                      "damage_kind",
                      "handler"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 8
                }
              },
              "required": [
                "trigger",
                "chance_bp",
                "interval_ms",
                "loss_threshold_milli",
                "condition",
                "actions"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 8
          }
        },
        "required": [
          "legacyId",
          "originalTextSha256",
          "why",
          "proposal",
          "jsNotes",
          "parity",
          "lifecycle",
          "rules"
        ],
        "additionalProperties": false
      },
      "minItems": 15,
      "maxItems": 15
    }
  },
  "required": [
    "schemaVersion",
    "profile",
    "pilots"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
