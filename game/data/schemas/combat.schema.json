    "ruleset":{"type":"object","required":["rulesetVersion","canonicalDataVersion","clockUnit","maxTimeMs","maxEvents","maxReactionDepth","energyCapMilli","criticalCapBp","minimumAttackDamageMilli","minimumBasicIntervalMs","minimumIceRateBp","stunnedEnergyRateBp","dotIntervalMs","legacyStatusMaxStacks","legacyWoundFallbackBp","legacyIceFallbackBp","specification","sourceBasis"],"additionalProperties":false,"properties":{"rulesetVersion":{"const":"combat_v1.17.1"},"canonicalDataVersion":{"const":"v1.16.1"},"clockUnit":{"const":"millisecond"},"maxTimeMs":{"const":45000},"maxEvents":{"const":20000},"maxReactionDepth":{"const":16},"energyCapMilli":{"const":100000},"criticalCapBp":{"const":9000},"minimumAttackDamageMilli":{"const":1000},"minimumBasicIntervalMs":{"const":250},"minimumIceRateBp":{"const":3500},"stunnedEnergyRateBp":{"const":3000},"dotIntervalMs":{"const":1000},"legacyStatusMaxStacks":{"const":20},"legacyWoundFallbackBp":{"const":500},"legacyIceFallbackBp":{"const":1000},"specification":{"const":"docs/product-specs/COMBAT_RULES.md"},"sourceBasis":{"type":"string"}}},
    "contracts":{"type":"object","required":["schemaVersion","records"],"additionalProperties":false,"properties":{"schemaVersion":{"const":1},"records":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"object","required":["cardId","originalTextSha256","lethalRules"],"additionalProperties":false,"properties":{"cardId":{"enum":["legacy_049","legacy_090","legacy_120"]},"originalTextSha256":{"$ref":"#/$defs/hash"},"lethalRules":{"$ref":"#/$defs/lethal"}}}}}},
    "catalog":{"type":"object","required":["schemaVersion","rulesetVersion","canonicalDataVersion","generator","sources","ruleset","heroes","effects"],"additionalProperties":false,"properties":{"schemaVersion":{"const":1},"rulesetVersion":{"const":"combat_v1.17.1"},"canonicalDataVersion":{"const":"v1.16.1"},"generator":{"const":"tools/migration/combat_data.py"},"sources":{"$ref":"#/$defs/sources"},"ruleset":{"$ref":"#/$defs/ruleset"},"heroes":{"type":"array","minItems":16,"maxItems":16,"items":{"type":"object","required":["id","stats","skill","provenance"],"additionalProperties":false,"properties":{"id":{"$ref":"#/$defs/label"},"stats":{"$ref":"#/$defs/stats"},"skill":{"$ref":"#/$defs/skill"},"provenance":{"$ref":"#/$defs/provenance"}}}},"effects":{"type":"array","minItems":150,"maxItems":150,"items":{"type":"object","required":["id","rules","base_text_allowed","numbered_levels","lethal_rules","unresolved","source_text_hash"],"additionalProperties":false,"properties":{"id":{"$ref":"#/$defs/id"},"rules":{"type":"array","maxItems":2},"base_text_allowed":{"type":"boolean"},"numbered_levels":{"enum":[[],[1]]},"lethal_rules":{"$ref":"#/$defs/lethal"},"unresolved":{"type":"string"},"source_text_hash":{"$ref":"#/$defs/hash"}}}}}},
    "levels":{"type":"object","required":["schemaVersion","rulesetVersion","canonicalDataVersion","generator","sources","records"],"additionalProperties":false,"properties":{"schemaVersion":{"const":1},"rulesetVersion":{"const":"combat_v1.17.1"},"canonicalDataVersion":{"const":"v1.16.1"},"generator":{"const":"tools/migration/combat_data.py"},"sources":{"$ref":"#/$defs/sources"},"records":{"type":"array","minItems":582,"maxItems":582,"items":{"type":"object","required":["cardId","level","maxLevel","sourceLevel","legacyOracleValues","canonicalNumberedExecutable","provenance"],"additionalProperties":false,"properties":{"cardId":{"$ref":"#/$defs/id"},"level":{"type":"integer","minimum":1,"maximum":5},"maxLevel":{"enum":[1,3,5]},"sourceLevel":{"type":"object"},"legacyOracleValues":{"type":"object","additionalProperties":{"type":"number"}},"canonicalNumberedExecutable":{"type":"boolean"},"provenance":{"$ref":"#/$defs/provenance"}}}}}},
    "event":{"type":"object","required":["sequence","at_ms","type","source","target","parent_sequence","payload"],"additionalProperties":false,"properties":{"sequence":{"type":"integer","minimum":1,"maximum":20000},"at_ms":{"type":"integer","minimum":0,"maximum":45000},"type":{"enum":["CombatStarted","CombatEnded","BasicAttack","SkillCast","EffectTriggered","EnergyGained","StatusTick","StatusApplied","StatusIgnored","StatusExpired","Dodged","ShieldAbsorbed","DamageApplied","HealApplied","LethalReached","DeathPrevented","RebirthTriggered","CombatantRevived","CombatantKO"]},"source":{"type":"string"},"target":{"type":"string"},"parent_sequence":{"type":"integer","minimum":0,"maximum":19999},"payload":{"type":"object"}}},
    "replay":{"type":"object","required":["formatVersion","rulesetVersion","canonicalDataVersion","dataHash","scenarioId","seed","initialState","events","finalState","eventHash","resultHash"],"additionalProperties":false,"properties":{"formatVersion":{"const":1},"rulesetVersion":{"const":"combat_v1.17.1"},"canonicalDataVersion":{"const":"v1.16.1"},"dataHash":{"$ref":"#/$defs/hash"},"scenarioId":{"$ref":"#/$defs/label"},"seed":{"type":"integer","minimum":0,"maximum":4294967295},"initialState":{"type":"object"},"events":{"type":"array","minItems":2,"maxItems":20000,"items":{"$ref":"#/$defs/event"}},"finalState":{"type":"object"},"eventHash":{"$ref":"#/$defs/hash"},"resultHash":{"$ref":"#/$defs/hash"}}}
  }
}
