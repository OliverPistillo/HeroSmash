    "stats":{"type":"object","required":["max_hp_milli","attack_milli","armor_milli","focus_milli","attack_speed_milli","crit_bp","crit_multiplier_bp","energy_regen_milli","dodge_bp"],"additionalProperties":false,"properties":{"max_hp_milli":{"type":"integer","minimum":1,"maximum":1000000000},"attack_milli":{"$ref":"#/$defs/int"},"armor_milli":{"$ref":"#/$defs/int"},"focus_milli":{"$ref":"#/$defs/int"},"attack_speed_milli":{"type":"integer","minimum":1,"maximum":10000},"crit_bp":{"type":"integer","minimum":0,"maximum":10000},"crit_multiplier_bp":{"type":"integer","minimum":0,"maximum":100000},"energy_regen_milli":{"$ref":"#/$defs/int"},"dodge_bp":{"type":"integer","minimum":0,"maximum":10000}}},
    "skill":{"type":"object","required":["name","cooldown_ms","cost_milli","power_bp","damage_type","status","duration_ms","dot_milli_per_second"],"additionalProperties":false,"properties":{"name":{"$ref":"#/$defs/label"},"cooldown_ms":{"type":"integer","minimum":1,"maximum":45000},"cost_milli":{"type":"integer","minimum":0,"maximum":100000},"power_bp":{"type":"integer","minimum":0,"maximum":100000},"damage_type":{"enum":["physical","magic"]},"status":{"enum":["","toxin","burn","wound","ice","stun"]},"duration_ms":{"type":"integer","minimum":1,"maximum":45000},"dot_milli_per_second":{"type":"integer","minimum":0,"maximum":100000}}},
