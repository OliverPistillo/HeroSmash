  "$defs":{
    "int":{"type":"integer","minimum":0,"maximum":1000000000},
    "label":{"type":"string","minLength":1,"maxLength":100},
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "id":{"type":"string","pattern":"^legacy_[0-9]{3}$"},
